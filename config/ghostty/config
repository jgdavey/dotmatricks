# --- Theme and Aesthetics ---
#theme = dark:iTerm2 Smoooooth,light:iTerm2 Solarized Light
theme = iTerm2 Smoooooth
font-family = "Hack Nerd Font Mono"
font-size = 12
bold-color = bright

# --- Window Adjustments ---
window-padding-x = 6
window-padding-y = 6
window-padding-balance = true
# window-decoration = true

# --- Mouse & Interaction ---
# copy-on-select = true
# mouse-scroll-multiplier = 2

# --- Custom Keybindings ---
# Force standard macOS-style shortcut to launch your terminal editor config directly
keybind = super+,=text:ghostty +edit-config\n
