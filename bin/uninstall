#!/usr/bin/env bash
set -e

force=

while [ $# -gt 0 ]; do
  case "$1" in
    -f|--force) force=1 ;;
    (--) shift; break ;;
    (*) break ;;
  esac
  shift
done

source $(dirname $0)/dot_functions.sh

directory_warning

remove_or_skip() {
  path="$1"
  source="$2"
  force=$3

  status="$(path_status $path $dotmatrix_path)"
  unlink=

  case "$status" in
    "linked" ) unlink=1 ;;
    "external" ) if [[ -n "$force" ]]; then
                   unlink=1
                 fi ;;
    * ) ;;
  esac

  if [[ -z "$unlink" ]]; then
    skip_notice "~${path#$HOME}" "$status"
  else
    remove_notice "~${path#$HOME}" "$status"
    unlink $path
  fi
}

for file in $(./bin/file_list.sh); do
  dotmatrix_path="$(source_path $file)"
  path="$HOME/.$file"

  remove_or_skip $path "$dotmatrix_path" $force
done
