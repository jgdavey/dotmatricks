#!/usr/bin/env bash
set -e

force=

while [ $# -gt 0 ]; do
  case "$1" in
    -f|--force) force=1 ;;
    (--) shift; break ;;
    (*) break ;;
  esac
  shift
done

source $(dirname $0)/dot_functions.sh

directory_warning

link_or_skip() {
  path="$1"
  source="$2"
  force=$3

  status="$(path_status $path $dotmatrix_path)"
  install=

  case "$status" in
    "external" ) if [[ -n "$force" ]]; then
                   install=1
                 fi ;;
    "absent" ) install=1 ;;
    * ) ;;
  esac

  if [[ -z "$install" ]]; then
    skip_notice "~${path#$HOME}" "$status"
  else
    link_notice "~${path#$HOME}" "$status"
    mkdir -p "$(dirname $path)"
    ln -nfs "$dotmatrix_path" "$path"
  fi
}

# Copy *.local files
for file in *.local ; do
  dotmatrix_path=$PWD/$file
  path="$HOME/.$file"

  if [ ! -e $path ]; then
    copy_notice "~/.${file}" "absent"
    cp $dotmatrix_path $path
  else
    skip_notice "~/.${file}" "exists"
  fi
done

# dotfiles and config
for file in $(./bin/file_list.sh); do
  dotmatrix_path="$(source_path $file)"
  path="$HOME/.$file"

  [ -e $dotmatrix_path ] || continue

  link_or_skip $path "$dotmatrix_path" $force
done

# remove links to files that are no longer in the repo
{ find "$HOME" -maxdepth 1 -type l; find "$HOME/.config" -type l; } 2>/dev/null | while read link; do
  target="$(readlink "$link")"
  case "$target" in
    "$PWD"/dotfiles/*|"$PWD"/config/*)
      if [[ ! -e "$target" ]]; then
        remove_notice "~${link#$HOME}" "dead"
        unlink "$link"
      fi ;;
  esac
done
