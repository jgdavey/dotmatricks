# -*- mode: sh; -*-
# vim: set ft=sh sw=2 sts=2:

[ -e "$SOURCE_DIR" ] || SOURCE_DIR="$HOME/src"
export SOURCE_DIR

export GOPATH="$SOURCE_DIR/go"
export WASMTIME_HOME="$HOME/.wasmtime"

# Homebrew stuff
export HOMEBREW_PREFIX="/opt/homebrew";
export HOMEBREW_CELLAR="${HOMEBREW_PREFIX}/Cellar";
export HOMEBREW_REPOSITORY="${HOMEBREW_PREFIX}";
export MANPATH="${HOMEBREW_PREFIX}/share/man${MANPATH+:$MANPATH}:";
export INFOPATH="${HOMEBREW_PREFIX}/share/info:${INFOPATH:-}";
# end Homebrew stuff

# Paths for prepending (if missing)
for dir in /usr/local/bin "$HOMEBREW_PREFIX/bin" "$WASMTIME_HOME/bin" "$GOPATH/bin" "$HOME/.cargo/bin"; do
  case ":$PATH:" in
    *:"$dir":*) ;;
    *) [ ! -d "$dir" ] || PATH="$dir:$PATH" ;;
  esac
done

# Paths for forcibly prepending
for dir in "$HOME/bin" "$HOME/.local/bin" ".git/safe/../../bin" ; do
  case ":$PATH:" in
    *:"$dir":*) PATH="`echo "$PATH"|sed -e "s#:$dir##"`" ;;
  esac
  case "$dir" in
    /*) [ ! -d "$dir" ] || PATH="$dir:$PATH" ;;
    *) PATH="$dir:$PATH" ;;
  esac
done

# Paths for appending (if missing)
for dir in /usr/local/sbin /opt/local/sbin /usr/X11/bin "$HOMEBREW_PREFIX/sbin"; do
  case ":$PATH:" in
    *:"$dir":*) ;;
    *) [ ! -d "$dir" ] || PATH="$PATH:$dir" ;;
  esac
done

export PATH
