# -*- mode: sh; -*-
# vim: set ft=sh sw=2 sts=2:

[[ -e "$SOURCE_DIR" ]] || SOURCE_DIR="$HOME/src"
export SOURCE_DIR

export GOPATH="$SOURCE_DIR/go"
export WASMTIME_HOME="$HOME/.wasmtime"

# Homebrew stuff
export HOMEBREW_PREFIX="/opt/homebrew";
export HOMEBREW_CELLAR="${HOMEBREW_PREFIX}/Cellar";
export HOMEBREW_REPOSITORY="${HOMEBREW_PREFIX}";
export MANPATH="${HOMEBREW_PREFIX}/share/man${MANPATH+:$MANPATH}:";
export INFOPATH="${HOMEBREW_PREFIX}/share/info:${INFOPATH:-}";
# end Homebrew stuff

# Move a dir to the front of PATH, dropping any existing occurrences
_path_prepend() {
  local p=":$PATH:"
  while [[ "$p" == *":$1:"* ]]; do
    p="${p//":$1:"/:}"
  done
  p="${p#:}"
  p="${p%:}"
  PATH="$1${p:+:$p}"
}

# Paths for prepending, lowest priority first. Existing entries are moved
# to the front, since macOS's path_helper (run from /etc/zprofile and
# /etc/profile) puts the system dirs ahead of these in login shells.
for dir in /usr/local/bin "$HOMEBREW_PREFIX/bin" "$WASMTIME_HOME/bin" "$GOPATH/bin" "$HOME/.cargo/bin" \
           "$HOME/bin" "$HOME/.local/bin" ".git/safe/../../bin"; do
  case "$dir" in
    /*) [[ ! -d "$dir" ]] || _path_prepend "$dir" ;;
    *) _path_prepend "$dir" ;;
  esac
done

unset -f _path_prepend

# Paths for appending (if missing)
for dir in /usr/local/sbin /opt/local/sbin /usr/X11/bin "$HOMEBREW_PREFIX/sbin"; do
  case ":$PATH:" in
    *:"$dir":*) ;;
    *) [[ ! -d "$dir" ]] || PATH="$PATH:$dir" ;;
  esac
done

export PATH
