# -*- mode: sh; -*-
# vim: set ft=sh sw=2 sts=2:

# git_prompt_info accepts 0 or 1 arguments (i.e., format string)
# returns text to add to bash PS1 prompt (includes branch name)
git_prompt_info () {
  local g="$(command git rev-parse --git-dir 2>/dev/null)"
  if [ -n "$g" ]; then
    local r
    local b
    local d
    local s
    # Rebasing
    if [ -d "$g/rebase-apply" ] ; then
      if test -f "$g/rebase-apply/rebasing" ; then
        r="|REBASE"
      fi
      b="$(command git symbolic-ref HEAD 2>/dev/null)"
    # Interactive rebase
    elif [ -f "$g/rebase-merge/interactive" ] ; then
      r="|REBASE-i"
      b="$(cat "$g/rebase-merge/head-name")"
    # Merging
    elif [ -f "$g/MERGE_HEAD" ] ; then
      r="|MERGING"
      b="$(command git symbolic-ref HEAD 2>/dev/null)"
    else
      if [ -f "$g/BISECT_LOG" ] ; then
        r="|BISECTING"
      fi
      if ! b="$(command git symbolic-ref HEAD 2>/dev/null)" ; then
        if ! b="$(command git describe --exact-match HEAD 2>/dev/null)" ; then
          b="$(cut -c1-7 "$g/HEAD")..."
        fi
      fi
    fi

    # Dirty Branch
    local modified=
    local untracked=
    local deleted=
    local conflicted=
    while read -r primary secondary rest; do
      case "$primary" in
        "?" ) untracked=1 ;;
        "u" ) conflicted=1 ;;
        "1" | "2" ) case "$secondary" in
                      *M*) modified=1 ;;
                      *D*) deleted=1 ;;
                    esac;;
      esac
    done < <(command git --no-optional-locks status --porcelain=2 2> /dev/null)

    d=""
    [[ -z "$conflicted" ]] || d+='!'
    [[ -z "$untracked" ]] || d+='+'
    [[ -z "$modified" ]]  || d+='*'
    [[ -z "$deleted" ]] || d+='-'

    printf "${1-"(%s) "}" "${b##refs/heads/}$r$d"
  fi
}

LS_COMMAND="ls"
# Do we need Linux or BSD Style?
if command -v lsd > /dev/null; then
  LS_COMMAND="command lsd"
elif ls --color -d $PWD &>/dev/null 2>&1 ; then
  LS_COMMAND="ls --color=auto"
else
  LS_COMMAND="ls -G"
fi
export LS_COMMAND

alias cd..='cd ..'
alias ..='cd ..'
alias ll="$LS_COMMAND -l"
alias l="$LS_COMMAND -F -lah"
alias la="$LS_COMMAND -a"

alias gap='git add -p'
alias gb='git branch'
alias gc='git commit -v'
alias gd='git diff'
alias gdc='git diff --cached'
alias gp='git push'
alias gpr='git pull --rebase'
alias gst='git status'
alias grc='git rebase --continue'
alias gra='git rebase --abort'
alias grep='command grep --color=auto'

alias reset-authors='git commit --amend --reset-author -C HEAD'
alias vi='vim'

MY_SHELL=""

if [[ -n "$BASH_VERSION" ]]; then
  MY_SHELL="bash"
else
  case "$SHELL" in
    *zsh)   MY_SHELL="zsh" ;;
    *bash)  MY_SHELL="bash" ;;
  esac
fi

if command -v mise >/dev/null ; then
  eval "$(mise activate $MY_SHELL)"
fi

JD_ROOT="${SOURCE_DIR}/dotmatricks/jd"

if [[ -d "${JD_ROOT}" ]]; then
  eval "$(${JD_ROOT}/bin/jd init - ${MY_SHELL})"
  source "${JD_ROOT}/share/aliases"
fi

# Use emacsclient (via the `ec` wrapper in jd/bin) as the editor. It opens a
# GUI frame on macOS, a terminal frame on headless boxes, and starts a daemon
# if needed. $EDITOR must be a single executable path for tools that exec it
# directly, so resolve `ec` to its absolute path (falling back to vim).
export EDITOR="$(command -v ec || command -v emacsclient)"
export VISUAL="$EDITOR"

alias sudoedit="sudo -e"

E() {
    SUDO_EDITOR="$EDITOR" sudoedit "$@"
}

e() {
    ec "$@"
}

# http://twistedcode.blogspot.com/2008/04/lscolors-explained.html
# Match tool for ls colors: https://geoff.greer.fm/lscolors/
export CLICOLOR=1
export LSCOLORS=ExFxcxdxbxegedabagacad
export LS_COLORS="no=00:fi=00:di=1;34:ln=1;35:so=32:pi=33:ex=31:bd=34;46:cd=34;43:su=30;41:sg=30;46:tw=30;42:ow=30;43"
export RI="--format ansi -T"
export GREP_COLOR='1;32'
export LESS=RF
export JRUBY_OPTS="-J-XX:+TieredCompilation -J-XX:TieredStopAtLevel=1 -J-noverify"

change-default-branch-name() {
    local OLDBRANCH="${1:-master}"
    local BRANCH="${2:-main}"
    git checkout -b "$BRANCH" 2>/dev/null || git checkout "$BRANCH"
    git push -u origin "$BRANCH:$BRANCH" >/dev/null
    gh repo edit --default-branch "$BRANCH"
    git branch -D "$OLDBRANCH" 2>/dev/null
    git push origin :"$OLDBRANCH"
}
